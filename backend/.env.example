# OPF Capital Dashboard - Environment Configuration
# Copy this file to .env and update with your actual credentials
# For production deployment, see docs/DEPLOYMENT.md

# Application
APP_NAME="OPF Capital Dashboard"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Connection
# For production, use MySQL or PostgreSQL (not SQLite)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=opf_capital_dashboard
DB_USERNAME=root
DB_PASSWORD=

# For SQLite (development only)
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# For production, use SESSION_SECURE_COOKIE=true with HTTPS
SESSION_SECURE_COOKIE=false

# Broadcasting & Filesystem
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Queue (for background jobs)
QUEUE_CONNECTION=database

# Cache
CACHE_STORE=database
CACHE_PREFIX=opf_

# Redis (optional, for production caching/sessions)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MEMCACHED_HOST=127.0.0.1

# Mail Configuration (for notifications and alerts)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@opfcapital.com"
MAIL_FROM_NAME="${APP_NAME}"

# For production, use a real SMTP service
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls

# AWS (optional, for S3 file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Frontend Build
VITE_APP_NAME="${APP_NAME}"

# API Rate Limiting (requests per minute)
API_RATE_LIMIT=60

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_PATH=storage/backups
BACKUP_RETENTION_DAYS=30

# Health Check
HEALTH_CHECK_ENABLED=true

# Production Security Settings (uncomment for production)
# APP_ENV=production
# APP_DEBUG=false
# SESSION_SECURE_COOKIE=true
# LOG_LEVEL=error
# CACHE_STORE=redis
# SESSION_DRIVER=redis
# QUEUE_CONNECTION=redis
