# OPF-CD Production Environment Variables
# Copy this to .env and update the values

# Database passwords (CHANGE THESE!)
DB_PASSWORD=opfcd_secure_db_password_2026_change_me
DB_ROOT_PASSWORD=opfcd_root_password_2026_change_me

# Redis password (CHANGE THIS!)
REDIS_PASSWORD=opfcd_redis_password_2026_change_me

# Laravel Application Key (Generate with: php artisan key:generate --show)
APP_KEY=base64:your_generated_app_key_here

# Domain and URLs
DOMAIN=opfcd.3bs.ltd
APP_URL=https://opfcd.3bs.ltd

# SSL Email for Let's Encrypt
SSL_EMAIL=your-email@domain.com

# Backup settings
BACKUP_RETENTION_DAYS=30